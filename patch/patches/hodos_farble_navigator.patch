+++ third_party/blink/renderer/core/execution_context/navigator_base.h
@@ -56,6 +56,12 @@ class CORE_EXPORT NavigatorBase : public ScriptWrappable,
 
   unsigned int hardwareConcurrency() const override;
 
+  // Hodos farbling (C6). Overridden here rather than in NavigatorDeviceMemory itself
+  // because this is the lowest class in the hierarchy that has an ExecutionContext, and
+  // therefore the per-origin HodosSessionCache. hardwareConcurrency above is farbled in
+  // the same place, for the same reason -- it was already overridden here upstream.
+  float deviceMemory() const override;
+
  protected:
   ExecutionContext* GetUAExecutionContext() const override;
   UserAgentMetadata GetUserAgentMetadata() const override;
diff --git third_party/blink/renderer/core/frame/navigator_device_memory.h third_party/blink/renderer/core/frame/navigator_device_memory.h
index 33fe17542a9c1..60b58e0957418 100644
--- third_party/blink/renderer/core/frame/navigator_device_memory.h
+++ third_party/blink/renderer/core/frame/navigator_device_memory.h
@@ -11,7 +11,12 @@ namespace blink {
 
 class CORE_EXPORT NavigatorDeviceMemory {
  public:
-  float deviceMemory() const;
+  // Hodos farbling (C6): virtual so NavigatorBase can override it, which is the only way
+  // this value can be farbled -- the mixin itself has no ExecutionContext, while
+  // NavigatorBase is an ExecutionContextClient and is the common base of both Navigator
+  // and WorkerNavigator. This mirrors NavigatorConcurrentHardware::hardwareConcurrency(),
+  // which is already virtual and already overridden there for the same structural reason.
+  virtual float deviceMemory() const;
 };
 
 }  // namespace blink
