+#include "third_party/blink/renderer/core/execution_context/hodos_session_cache.h"
+
+#include <iterator>
+
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+
+namespace blink {
+
+namespace {
+
+// splitmix64 (Vigna, public domain). Used only to expand a seed into well-mixed
+// state; xoshiro's authors recommend exactly this for initialization, because
+// seeding the state directly from structured input produces poor early output.
+uint64_t SplitMix64(uint64_t& x) {
+  x += 0x9e3779b97f4a7c15ULL;
+  uint64_t z = x;
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+  return z ^ (z >> 31);
+}
+
+inline uint32_t RotL(uint32_t x, int k) {
+  return (x << k) | (x >> (32 - k));
+}
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// HodosPrng -- xoshiro128++ (Blackman & Vigna, public domain algorithm).
+//
+// Chosen over std::mt19937 because it is a few instructions per value with no
+// heap state, and PerturbPixels calls it once per pixel on readback paths that
+// sites can invoke in a loop. Statistical quality far exceeds what perturbation
+// needs; the requirement that actually matters is reproducibility.
+// ---------------------------------------------------------------------------
+HodosPrng::HodosPrng(uint64_t seed, uint64_t stream) {
+  // Mixing the stream id into the seed (rather than, say, into the output) means
+  // two streams are independent sequences, not offsets of one sequence.
+  uint64_t x = seed ^ (stream * 0x9e3779b97f4a7c15ULL);
+  uint64_t a = SplitMix64(x);
+  uint64_t b = SplitMix64(x);
+  s_[0] = static_cast<uint32_t>(a);
+  s_[1] = static_cast<uint32_t>(a >> 32);
+  s_[2] = static_cast<uint32_t>(b);
+  s_[3] = static_cast<uint32_t>(b >> 32);
+  // All-zero state is xoshiro's one degenerate case: it would emit zeros forever.
+  // SplitMix64 makes it vanishingly unlikely, but the cost of ruling it out is one
+  // branch on a path that runs once per context.
+  if ((s_[0] | s_[1] | s_[2] | s_[3]) == 0) {
+    s_[0] = 1u;
+  }
+}
+
+uint32_t HodosPrng::Next() {
+  const uint32_t result = RotL(s_[0] + s_[3], 7) + s_[0];
+  const uint32_t t = s_[1] << 9;
+  s_[2] ^= s_[0];
+  s_[3] ^= s_[1];
+  s_[1] ^= s_[2];
+  s_[0] ^= s_[3];
+  s_[2] ^= t;
+  s_[3] = RotL(s_[3], 11);
+  return result;
+}
+
+double HodosPrng::NextDouble() {
+  // 2^-32, so the result lands in [0, 1) with uniform spacing.
+  return static_cast<double>(Next()) * 2.3283064365386963e-10;
+}
+
+// ---------------------------------------------------------------------------
+// HodosSessionCache
+// ---------------------------------------------------------------------------
+
+// static
+const char HodosSessionCache::kSupplementName[] = "HodosSessionCache";
+
+HodosSessionCache::HodosSessionCache(ExecutionContext& context)
+    : Supplement<ExecutionContext>(context) {}
+
+// static
+HodosSessionCache& HodosSessionCache::From(ExecutionContext& context) {
+  HodosSessionCache* cache =
+      Supplement<ExecutionContext>::From<HodosSessionCache>(context);
+  if (!cache) {
+    cache = MakeGarbageCollected<HodosSessionCache>(context);
+    Supplement<ExecutionContext>::ProvideTo(context, cache);
+  }
+  // Deliberately returns a reference: callers are patched hot paths inside Blink
+  // API implementations, and a null check at every one of them is a null check
+  // someone eventually forgets. A key-less cache is already safe -- it reports
+  // FarblingEnabled() == false and every helper degrades to a no-op.
+  return *cache;
+}
+
+void HodosSessionCache::SetOriginKey(const std::array<uint8_t, 32>& domain_key,
+                                     bool farbling_enabled) {
+  domain_key_ = domain_key;
+  farbling_enabled_ = farbling_enabled;
+  has_key_ = true;
+}
+
+uint64_t HodosSessionCache::KeySeed() const {
+  // FNV-1a over the 32 key bytes. The key is already a uniformly distributed
+  // HMAC output, so this only needs to fold it to 64 bits without discarding
+  // material -- taking the first 8 bytes would work too, but folding means a
+  // future change to the key derivation cannot silently reduce our entropy.
+  uint64_t h = 1469598103934665603ULL;
+  for (uint8_t byte : domain_key_) {
+    h ^= byte;
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+
+HodosPrng HodosSessionCache::MakePrng(Stream stream) const {
+  return HodosPrng(KeySeed(), static_cast<uint64_t>(stream));
+}
+
+void HodosSessionCache::PerturbPixels(uint8_t* pixels,
+                                      size_t length_in_bytes,
+                                      Stream stream) {
+  if (!FarblingEnabled() || !pixels) {
+    return;
+  }
+  HodosPrng prng = MakePrng(stream);
+  // Step by 4 (RGBA) and touch only the red channel's low bit: invisible on screen,
+  // decisive for any hash of the buffer. Matches the outgoing JS behaviour exactly,
+  // including the 3% rate, so an already-enrolled user's fingerprint does not change
+  // underneath them when this replaces the injected script.
+  for (size_t i = 0; i + 3 < length_in_bytes; i += 4) {
+    if (prng.NextDouble() < 0.03) {
+      pixels[i] ^= 1u;
+    }
+  }
+}
+
+double HodosSessionCache::AudioFudgeFactor() {
+  if (!FarblingEnabled()) {
+    return 1.0;
+  }
+  HodosPrng prng = MakePrng(Stream::kAudio);
+  return 1.0 + (prng.NextDouble() - 0.5) * 0.0000004;
+}
+
+void HodosSessionCache::PerturbAudioSamples(float* samples, size_t count) {
+  if (!FarblingEnabled() || !samples) {
+    return;
+  }
+  const double fudge = AudioFudgeFactor();
+  for (size_t i = 0; i < count; ++i) {
+    samples[i] = static_cast<float>(samples[i] * fudge);
+  }
+}
+
+float HodosSessionCache::FarbleDeviceMemory(float native) {
+  if (!FarblingEnabled()) {
+    return native;
+  }
+  // Every entry is a value this engine's own approximation can produce, so the result
+  // is indistinguishable from an honest answer given by some other desktop.
+  static constexpr float kDesktopValues[] = {4.0f, 8.0f, 16.0f, 32.0f};
+  HodosPrng prng = MakePrng(Stream::kDeviceMemory);
+  const uint32_t index = prng.Next() % std::size(kDesktopValues);
+  return kDesktopValues[index];
+}
+
+unsigned HodosSessionCache::FarbleHardwareConcurrency(unsigned real) {
+  // kFloor is why this cannot report 1: a single-core claim is rare enough on a desktop
+  // to be conspicuous, and it also changes how sites schedule work rather than merely
+  // what they record.
+  constexpr unsigned kFloor = 2u;
+  if (!FarblingEnabled() || real <= kFloor) {
+    return real;
+  }
+  HodosPrng prng = MakePrng(Stream::kHardwareConcurrency);
+  // Uniform over [kFloor, real] inclusive -- so the true value stays reachable, and the
+  // result can never exceed it.
+  const unsigned span = real - kFloor + 1u;
+  return kFloor + (prng.Next() % span);
+}
+
+void HodosSessionCache::Trace(Visitor* visitor) const {
+  Supplement<ExecutionContext>::Trace(visitor);
+}
+
+}  // namespace blink
