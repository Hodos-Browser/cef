+// Copyright 2026 Marston Enterprises. All rights reserved.
+// Use of this source code is governed by a BSD-style license identical to
+// Chromium's; see the Chromium LICENSE file in the root of this tree.
+//
+// CLEAN-ROOM PROVENANCE (Hodos M7): this file is an independent implementation
+// written from a behavioral specification -- development-docs/0.4.0/chromium-rebuild/
+// PLAN_farbling_blink.md sections 3, 4 and 7, CreepJS's observable expectations, and
+// Brave's *published design writeups* on per-eTLD+1 farbling. The Supplement mechanics
+// follow Chromium's own in-tree BSD example, core/context_features/
+// context_feature_settings.{h,cc}. No Brave (MPL-2.0) or Bromite (GPL-3) source was
+// read or adapted. The randomness below is the published public-domain splitmix64 /
+// xoshiro128++ construction by Blackman and Vigna, not anyone's browser code.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_HODOS_SESSION_CACHE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_HODOS_SESSION_CACHE_H_
+
+#include <array>
+#include <cstdint>
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+// Deterministic PRNG driving every Hodos perturbation.
+//
+// Deterministic is the whole point, not an implementation detail: a site must read
+// the SAME farbled value every time within one profile+origin, or it breaks (and the
+// instability is itself a fingerprint). So this is seeded purely from the per-origin
+// key plus a caller-supplied stream id -- never from time, entropy, or call order.
+class CORE_EXPORT HodosPrng {
+ public:
+  // `seed` is derived from the origin key; `stream` separates independent uses.
+  HodosPrng(uint64_t seed, uint64_t stream);
+
+  uint32_t Next();
+
+  // Uniform in [0, 1). Used for "perturb this element with probability p" tests.
+  double NextDouble();
+
+ private:
+  uint32_t s_[4];
+};
+
+// HodosSessionCache attaches Hodos's fingerprint-farbling state to an ExecutionContext.
+//
+// WHY A SUPPLEMENT ON ExecutionContext, and not injected JavaScript:
+//   * ExecutionContext is the common base of LocalDOMWindow, the worker global scopes
+//     and worklet scopes, so ONE attachment point covers every context type. The JS
+//     injection it replaces ran from OnContextCreated, which never fires for workers
+//     at all -- a window-vs-worker mismatch that is itself a classic tell.
+//   * Farbling happens at API-CALL time (inside getImageData, readPixels,
+//     getChannelData), so there is no injection-timing race and, crucially, the patched
+//     functions still report "[native code]" from toString(). Restoring that prototype
+//     integrity is a large part of why this migration exists.
+//   * State is per-context and GC-managed: no manual lifetime, no cross-frame leakage.
+//
+// FAIL-CLOSED BY CONSTRUCTION. A freshly created cache has no key, and with no key
+// FarblingEnabled() is false and every caller must fall through to the real Chromium
+// value. There is deliberately no "farble with a zero key" state: a degenerate
+// constant-seeded perturbation would be a *worse* fingerprint than not farbling, and
+// the auth-domain exemption depends on the bypass being a true native pass-through
+// rather than a differently-seeded farble.
+class CORE_EXPORT HodosSessionCache final
+    : public GarbageCollected<HodosSessionCache>,
+      public Supplement<ExecutionContext> {
+ public:
+  static const char kSupplementName[];
+
+  explicit HodosSessionCache(ExecutionContext&);
+
+  // Returns the cache for `context`, creating an empty (key-less, therefore
+  // pass-through) one if this is the first call for that context.
+  static HodosSessionCache& From(ExecutionContext&);
+
+  // Installs the per-origin material delivered by the browser process.
+  //
+  // `domain_key` is HMAC-SHA256(profile_seed, first-party eTLD+1), computed in the
+  // browser: the master profile seed never enters a renderer, and never appears on any
+  // command line. `farbling_enabled` is the browser's single ShouldFarble() verdict for
+  // the whole page -- global toggle AND auth-domain allowlist AND the user's per-site
+  // Privacy Shield toggle, already collapsed. The renderer does not re-decide.
+  void SetOriginKey(const std::array<uint8_t, 32>& domain_key,
+                    bool farbling_enabled);
+
+  // True only when a key has been delivered AND the browser said to farble.
+  // Every patched API must return the native value when this is false.
+  bool FarblingEnabled() const { return has_key_ && farbling_enabled_; }
+
+  // True once the browser has answered for this context at all, whatever the answer.
+  // Distinguishes "exempt" from "not told yet", which is what lets the delivery path
+  // know whether it still owes this context a fetch.
+  bool HasOriginKey() const { return has_key_; }
+
+  // Independent deterministic streams off the same origin key. Give each vector its
+  // own id so canvas noise and audio noise are not the same number sequence -- reusing
+  // one stream across APIs would let a site correlate them and recover the seed.
+  enum class Stream : uint64_t {
+    kCanvas = 1,
+    kWebglReadPixels = 2,
+    kAudio = 3,
+    kDeviceMemory = 4,
+    kHardwareConcurrency = 5,
+  };
+
+  HodosPrng MakePrng(Stream stream) const;
+
+  // Flips the low bit of the red channel of ~3% of pixels, matching the perturbation
+  // the outgoing JavaScript implementation applied, so fingerprints stay stable across
+  // the migration for users who are already enrolled somewhere.
+  //
+  // `pixels` is RGBA8. No-op when farbling is disabled. The caller owns the decision of
+  // WHICH readbacks to perturb -- in particular the small-canvas gate lives at the call
+  // site, because only the caller knows the surface's dimensions.
+  void PerturbPixels(uint8_t* pixels, size_t length_in_bytes,
+                     Stream stream = Stream::kCanvas);
+
+  // One multiplier per audio buffer, ~1.0 +/- 2e-7: below the audible floor and below
+  // the precision most fingerprinters hash at, but enough to move the hash. Returns
+  // exactly 1.0 when farbling is disabled, so callers may multiply unconditionally.
+  double AudioFudgeFactor();
+
+  // Applies AudioFudgeFactor() to `count` float samples in place (C5). One factor for
+  // the whole run, not one per sample, matching the JavaScript this replaces
+  // (`var fudge = ...` hoisted out of the loop). No-op when farbling is disabled, so
+  // callers need no branch of their own.
+  //
+  // ⚠️ The factor is DETERMINISTIC, so this is not idempotent in the way a caller might
+  // assume: applying it twice to the same storage yields factor^2 and drifts further on
+  // every repeat. Callers that perturb a buffer they do not own -- i.e. anything whose
+  // storage survives the call -- must perturb it exactly ONCE and remember that they
+  // did. Callers handed a fresh destination array each call (getFloatFrequencyData)
+  // have no such obligation.
+  void PerturbAudioSamples(float* samples, size_t count);
+
+  // navigator.deviceMemory (C6). Returns a value drawn from the desktop-plausible set
+  // {4, 8, 16, 32} -- a subset of what this engine's own ApproximatedDeviceMemory can
+  // report (powers of two in [2, 32], per kUpdatedDeviceMemoryLimitsFor2026, which is
+  // enabled by default here), so we never emit a quantity real Chrome could not.
+  //
+  // Deliberately NOT Brave's {0.25 ... 8}: that set is mobile-inclusive and caps at 8,
+  // which on a desktop is itself the tell. Returns `native` unchanged when farbling is
+  // disabled.
+  //
+  // ⚠️ TRIPWIRE for an engine bump: if kUpdatedDeviceMemoryLimitsFor2026 is removed or
+  // flipped off upstream, the cap returns to 8 and 16/32 become out-of-set values --
+  // i.e. this stops hiding us and starts marking us. Re-read
+  // blink/common/device_memory/approximated_device_memory.cc on every rebase.
+  float FarbleDeviceMemory(float native);
+
+  // navigator.hardwareConcurrency (C6). REDUCE-ONLY: the result is always <= the real
+  // core count, floored at 2. Never inflates.
+  //
+  // Inflation is not a symmetric choice. A 4-core machine claiming 16 is contradicted by
+  // any timing measurement the page can take for itself, so an inflated count is a NEW
+  // fingerprinting signal rather than a masked one. Reducing is merely conservative --
+  // plenty of real machines have few cores. Returns `real` unchanged when farbling is
+  // disabled, or when `real` is already at or below the floor.
+  unsigned FarbleHardwareConcurrency(unsigned real);
+
+  void Trace(Visitor*) const override;
+
+ private:
+  // Folds the 32-byte key into the 64 bits the PRNG is seeded from.
+  uint64_t KeySeed() const;
+
+  std::array<uint8_t, 32> domain_key_{};
+  bool has_key_ = false;
+  bool farbling_enabled_ = false;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_HODOS_SESSION_CACHE_H_
