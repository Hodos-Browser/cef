+// --- Hodos farbling (C3) ---------------------------------------------------
+// Returns a farbled COPY of `snapshot`, or `snapshot` itself when farbling is off
+// for this execution context (no key delivered, auth-domain exemption, or the
+// user's per-site Privacy Shield toggle -- the browser process collapses all
+// three into one bit and the renderer does not re-decide).
+//
+// IT MUST BE A COPY, and that is a correctness requirement rather than hygiene.
+// A snapshot can share pixels with the canvas's own backing store, and the
+// injected JavaScript this replaces farbled toDataURL by doing a getImageData ->
+// putImageData round-trip -- i.e. by writing perturbed pixels back INTO the
+// canvas. Because PerturbPixels is deterministic, a second read of an
+// already-perturbed canvas re-flips exactly the same bits and silently UNDOES the
+// first farble. Copying leaves the canvas pristine, so every read returns the
+// same farbled bytes, which is the intra-session consistency the whole scheme
+// depends on (an unstable fingerprint is itself a fingerprint).
+scoped_refptr<StaticBitmapImage> HodosFarbleSnapshot(
+    ExecutionContext* execution_context,
+    scoped_refptr<StaticBitmapImage> snapshot) {
+  if (!execution_context || !snapshot) {
+    return snapshot;
+  }
+  HodosSessionCache& cache = HodosSessionCache::From(*execution_context);
+  if (!cache.FarblingEnabled()) {
+    return snapshot;
+  }
+
+  auto paint_image = snapshot->PaintImageForCurrentFrame();
+  if (!paint_image) {
+    return snapshot;
+  }
+  const SkImageInfo source_info = paint_image.GetSkImageInfo();
+  if (source_info.isEmpty()) {
+    return snapshot;
+  }
+
+  // Read back into a canonical unpremultiplied RGBA8888 buffer.
+  //   * RGBA8888 so that PerturbPixels's "low bit of byte 0" is literally the red
+  //     channel whatever the source's native byte order is, and so a float-storage
+  //     (HDR) canvas is CONVERTED rather than reinterpreted as bytes.
+  //   * Unpremultiplied because that is what the image encoders want and what
+  //     ImageDataBuffer converts to anyway for every accelerated canvas
+  //     (image_data_buffer.cc does this same readPixels for exactly that reason).
+  //     It also keeps the perturbation from producing an invalid premultiplied
+  //     pixel where red could exceed alpha.
+  const SkImageInfo info =
+      SkImageInfo::Make(source_info.width(), source_info.height(),
+                        kRGBA_8888_SkColorType, kUnpremul_SkAlphaType,
+                        source_info.refColorSpace());
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size) || size == 0) {
+    return snapshot;
+  }
+
+  sk_sp<SkData> pixels = SkData::MakeUninitialized(size);
+  if (!paint_image.readPixels(info, pixels->writable_data(), row_bytes, 0, 0)) {
+    return snapshot;
+  }
+  cache.PerturbPixels(static_cast<uint8_t*>(pixels->writable_data()), size);
+
+  sk_sp<SkImage> farbled =
+      SkImages::RasterFromData(info, std::move(pixels), row_bytes);
+  if (!farbled) {
+    return snapshot;
+  }
+  // Unpremultiplied raster means ImageDataBuffer takes its peekPixels path over
+  // OUR private buffer -- no second GPU readback, and nothing else can observe it.
+  return UnacceleratedStaticBitmapImage::Create(std::move(farbled),
+                                                snapshot->Orientation());
+}
