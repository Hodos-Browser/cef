+      SkPixmap pixmap = image_data->GetSkPixmap();
+      // PerturbPixels walks the buffer as 4-byte RGBA and flips the low bit of
+      // byte 0. An ImageData with float storage (HDR / high-bit-depth canvases,
+      // reachable via ImageDataSettings) must not be reinterpreted that way, so
+      // anything other than 8-bit 4-channel passes through untouched.
+      const SkColorType color_type = pixmap.colorType();
