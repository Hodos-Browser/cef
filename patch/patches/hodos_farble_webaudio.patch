+    ExecutionContext* execution_context,
     unsigned channel_index,
     ExceptionState& exception_state) {
   if (channel_index >= channels_.size()) {
@@ -213,7 +216,31 @@ NotShared<DOMFloat32Array> AudioBuffer::getChannelData(
     return NotShared<DOMFloat32Array>(nullptr);
   }
 
-  return getChannelData(channel_index);
+  NotShared<DOMFloat32Array> channel_data = getChannelData(channel_index);
+
+  // --- Hodos farbling (C5) -------------------------------------------------
+  // The canonical WebAudio fingerprint renders a tone through a DynamicsCompressor in an
+  // OfflineAudioContext and hashes the samples this returns, so this is the readback that
+  // matters. A ~1.0 +/- 2e-7 multiplier sits far below the audible floor and below the
+  // precision fingerprinters hash at, yet moves the hash.
+  //
+  // Perturb ONCE per channel -- see farbled_channels_ in the header for why re-applying a
+  // deterministic factor to the buffer's own storage would compound and destroy the
+  // intra-session consistency the scheme depends on.
+  if (execution_context && channel_data) {
+    HodosSessionCache& cache = HodosSessionCache::From(*execution_context);
+    if (cache.FarblingEnabled()) {
+      if (farbled_channels_.size() < channels_.size()) {
+        farbled_channels_.resize(channels_.size());
+      }
+      if (!farbled_channels_[channel_index]) {
+        farbled_channels_[channel_index] = true;
+        cache.PerturbAudioSamples(channel_data->Data(), channel_data->length());
+      }
+    }
+  }
+
+  return channel_data;
 }
 
